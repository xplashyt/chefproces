# ---------------------------------------------------------------------------
# Copia este archivo como .env.local y llena los valores reales.
# .env.local está en .gitignore: la llave privada nunca debe subir al repo.
# Son 8 variables. Ninguna es opcional para cobrar de verdad.
# ---------------------------------------------------------------------------

# 1) Llave PÚBLICA de Wompi. Es la única que puede viajar al navegador (de ahí
#    el prefijo NEXT_PUBLIC_) porque solo sirve para tokenizar tarjetas.
#    Si empieza por "pub_test_" el sitio habla con sandbox; si empieza por
#    "pub_prod_" habla con producción. No hay ninguna otra bandera de entorno.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2) Llave PRIVADA de Wompi. Solo se usa en el servidor (crear y consultar
#    transacciones). Si esta llave se filtra, cualquiera puede mover plata.
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 3) Secreto de INTEGRIDAD. Con él se firma (SHA-256) la terna
#    referencia + monto + moneda. Wompi rechaza la transacción si el monto que
#    enviamos no coincide con la firma: así nadie puede pagar $1.000 un plan de
#    $89.900 manipulando el navegador.
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXXXXXX

# 4) Secreto de EVENTOS. Con él se valida el checksum del webhook. Sin esta
#    verificación cualquiera podría hacer POST a /api/wompi/webhook y regalarse
#    el acceso al curso.
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXXXXXX

# 5) API key de Resend (https://resend.com/api-keys).
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# 6) Remitente verificado en Resend. Debe pertenecer a un dominio verificado;
#    si no, Resend rechaza el envío. Para pruebas sirve onboarding@resend.dev.
EMAIL_FROM=Sazón Propio <hola@tudominio.com>

# 7) Correo interno del equipo: recibe el aviso de cada venta aprobada.
EMAIL_SOPORTE=ventas@tudominio.com

# 8) Enlace real donde la alumna entra al aula/grupo después de pagar.
#    Es lo que se pega en el correo de bienvenida.
URL_ACCESO_AULA=https://tudominio.com/aula/bienvenida
